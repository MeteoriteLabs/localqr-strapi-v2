{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "mobile_number": {
      "type": "string"
    },
    "mobile_number_visibility": {
      "type": "string"
    },
    "Language_preference": {
      "type": "string"
    },
    "accounts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::account.account",
      "mappedBy": "users_permissions_users"
    },
    "Language_Choice": {
      "type": "string",
      "default": "en"
    },
    "is_subscribed": {
      "type": "boolean",
      "default": false
    },
    "razorpay_customer_id": {
      "type": "string"
    },
    "instagramUserId": {
      "type": "string"
    },
    "instagramUsername": {
      "type": "string"
    },
    "instagramAccountType": {
      "type": "string"
    },
    "instagramAccessToken": {
      "type": "text"
    },
    "movie_lists": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::movie-list.movie-list",
      "mappedBy": "account"
    }
  }
}
