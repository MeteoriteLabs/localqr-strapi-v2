{
  "kind": "collectionType",
  "collectionName": "person_lists",
  "info": {
    "singularName": "person-list",
    "pluralName": "person-lists",
    "displayName": "PersonList"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "List_Name": {
      "type": "string",
      "required": true
    },
    "list_description": {
      "type": "text"
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "Visibility": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "display_order": {
      "type": "integer",
      "default": 0
    },
    "top_picks_heading": {
      "type": "string"
    },
    "account": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::account.account",
      "inversedBy": "person_lists"
    },
    "recommended_people": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::recommended-person.recommended-person",
      "mappedBy": "person_list"
    },
    "recommendation_list": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::recommendation-list.recommendation-list",
      "inversedBy": "person_lists"
    }
  }
}
