{
  "kind": "collectionType",
  "collectionName": "app_categories",
  "info": {
    "singularName": "app-category",
    "pluralName": "app-categories",
    "displayName": "App_Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "recommended_apps": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::recommended-app.recommended-app",
      "mappedBy": "app_category"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    }
  }
}
