{
  "kind": "collectionType",
  "collectionName": "product_lists",
  "info": {
    "singularName": "product-list",
    "pluralName": "product-lists",
    "displayName": "ProductList"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "List_Name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "Visibility": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "display_order": {
      "type": "integer",
      "default": 0
    },
    "top_products_heading": {
      "type": "string"
    },
    "account": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::account.account",
      "inversedBy": "product_lists"
    },
    "recommended_products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::recommended-product.recommended-product",
      "mappedBy": "product_list"
    },
    "list_description": {
      "type": "text"
    },
    "recommendation_list": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::recommendation-list.recommendation-list",
      "inversedBy": "product_lists"
    }
  }
}
