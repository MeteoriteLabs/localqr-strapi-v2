{
  "kind": "collectionType",
  "collectionName": "instagram_medias",
  "info": {
    "singularName": "instagram-media",
    "pluralName": "instagram-medias",
    "displayName": "Instagram-media"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "mediaId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "mediaType": {
      "type": "enumeration",
      "enum": [
        "IMAGE",
        "VIDEO",
        "CAROUSEL_ALBUM"
      ]
    },
    "caption": {
      "type": "text"
    },
    "mediaUrl": {
      "type": "text",
      "required": true
    },
    "thumbnailUrl": {
      "type": "text"
    },
    "permalink": {
      "type": "text"
    },
    "likeCount": {
      "type": "integer",
      "default": 0
    },
    "commentCount": {
      "type": "integer",
      "default": 0
    },
    "timestamp": {
      "type": "datetime"
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::account.account",
      "inversedBy": "user"
    }
  }
}
