    "slug": {
      "type": "string"
    },
    "Guide_Type": {
      "type": "enumeration",
      "enum": [
        "Itinerary",
        "Theme"
      ]
    },
    "Guide_Tags": {
      "type": "json"
    },
    "Place_Details": {
      "type": "json"
    },
    "Transportation": {
      "type": "json"
    },
    "Number_Of_Days": {
      "type": "integer"
    },
    "Category": {
      "type": "json"
    },
    "Best_Time_To_Visit": {
      "type": "json"
    }
