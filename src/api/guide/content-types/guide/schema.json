  },
  "attributes": {
    "Title": {
      "type": "string"
    },
    "Description": {
      "type": "blocks"
    },
    "Tips_Notes": {
      "type": "blocks"
    },
    "Visibility": {
      "type": "boolean"
    },
    "account": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::account.account",
      "inversedBy": "guides"
    },
    "Estimated_Budget": {
      "type": "json"
    },
