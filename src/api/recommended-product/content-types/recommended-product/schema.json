{
  "kind": "collectionType",
  "collectionName": "recommended_products",
  "info": {
    "singularName": "recommended-product",
    "pluralName": "recommended-products",
    "displayName": "RecommendedProduct"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "product_url": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "brand": {
      "type": "string"
    },
    "price": {
      "type": "decimal"
    },
    "currency": {
      "type": "string"
    },
    "buy_url": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "specifications": {
      "type": "json"
    },
    "user_recommendation_note": {
      "type": "blocks"
    },
    "user_rating": {
      "type": "integer"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "pin_order": {
      "type": "integer"
    },
    "display_order": {
      "type": "integer",
      "default": 0
    },
    "images": {
      "type": "json"
    },
    "product_list": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-list.product-list",
      "inversedBy": "recommended_products"
    },
    "product_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-category.product-category",
      "inversedBy": "recommended_products"
    }
  }
}
